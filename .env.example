# ===== PROXY (wajib untuk produksi) =====
# Format: http://user:pass@host:port | https://... | socks5://host:port
PROXY_URL=
# Opsional: rotasi acak untuk request stream/gambar (pisahkan koma)
PROXY_LIST=

# ===== Keamanan =====
# Rahasia untuk menandatangani URL proxy (WAJIB diganti, string acak panjang)
PROXY_SECRET=ganti-dengan-string-acak-panjang
# Opsional: jika diisi, semua endpoint (kecuali /home & /proxy) butuh ?apikey= atau header x-api-key
API_KEY=
# Aktifkan /debug (menampilkan JSON/XHR yang tertangkap browser) -> 1 untuk menyala
DEBUG_ENDPOINT=0

# ===== Target =====
BASE_URL=https://animeinweb.com
# Local only: path Chrome/Chromium bila paket puppeteer tidak terpasang
CHROME_PATH=
CACHE_TTL_SECONDS=300

# ===== Stream (anti iklan) =====
# Host video asli; link yang cocok diprioritaskan & dipakai sendirian jika ada
STREAM_HOST_RE=storage\.animein
# (opsional) pola iklan tambahan/pengganti
AD_RE=

# ===== Override manual (opsional, kalau auto-deteksi gagal) =====
# Placeholder: {id}/{animeId} {page} {epId} {index}
EPISODES_API_TEMPLATE=
SERVER_API_TEMPLATE=
EPISODE_URL_TEMPLATE=
